# Settings for scripts/setup-everything.sh. Copy this to setup.env (in the repo
# root, which git ignores) and uncomment what you want to change; the script
# reads it automatically. Or keep it elsewhere and pass --config /path/to/file.
#
# A command-line flag beats an environment variable, which beats this file.
# Plain KEY=VALUE lines only (no shell syntax is evaluated).

# Port the production server listens on (flag: --port).
#PORT=8000

# Where the data lives. SQLite, absolute path (flag: --db /path/to/workout.db):
#DATABASE_URL=sqlite:////home/pi/workout-data/workout.db
# Four slashes = absolute path; three = relative. Postgres also works if you
# install a driver into backend/.venv yourself (flag: --database-url):
#DATABASE_URL=postgresql+psycopg://user:pass@localhost/workout

# Node.js build downloaded into frontend/.tools/node when the system has none
# suitable (Vite 8 needs 22.12+ or 20.19+).
#NODE_VERSION=22.14.0
